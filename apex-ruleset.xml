<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="Apex Ruleset"
         xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="http://pmd.sourceforge.net/ruleset_2_0_0.xsd"
         xmlns:xi="http://www.w3.org/2001/XInclude"
         description="Custom ruleset for Apex static code analysis.">

    <!-- Import standard Apex rules from PMD -->
    <description>PMD rules for Apex code analysis</description>

    <rule ref="category/apex/bestpractices.xml"/>
    <rule ref="category/apex/codestyle.xml"/>
    <rule ref="category/apex/design.xml"/>
    <rule ref="category/apex/documentation.xml"/>
    <rule ref="category/apex/errorprone.xml"/>
    <rule ref="category/apex/performance.xml"/>
    <rule ref="category/apex/security.xml"/>

    <!-- Optional: disable or customize individual rules -->
    <!--
